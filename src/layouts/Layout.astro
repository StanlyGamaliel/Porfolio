---
import '../styles/global.css';

const { title = 'Stanly Briceño | Desarrollador Web' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Portfolio de Stanly Briceño, desarrollador web junior orientado al desarrollo Full Stack." />
		<meta name="author" content="Stanly Briceño" />
		<meta name="theme-color" content="#081525" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>{title}</title>
	</head>

	<body class="min-h-screen bg-[#081525]">
		<slot />
	</body>
</html>