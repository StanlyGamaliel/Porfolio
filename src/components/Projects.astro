
---
const projects = [
  {
    number: '01',
    title: 'Personal Finance Manager',
    category: 'FULL STACK DEVELOPMENT',
    description:
      'Aplicación web orientada a la gestión de finanzas personales. Su objetivo es facilitar el registro y seguimiento de ingresos, gastos y presupuestos.',
    technologies: ['Java', 'Spring Boot', 'PostgreSQL'],
    status: 'En desarrollo',
    icon: '01',
  },
  {
    number: '02',
    title: 'Language Academy',
    category: 'WEB DEVELOPMENT',
    description:
      'Diseño y desarrollo integral de un sitio web para una academia de idiomas, destinado a presentar su oferta formativa, cursos y clases.',
    technologies: ['HTML5', 'CSS3', 'JavaScript', 'Netlify'],
    status: 'En desarrollo',
    icon: '02',
  },
];
---

<section
  id="proyectos"
  class="mx-auto max-w-6xl px-6 py-24"
>
  <div class="mb-12">
    <p class="font-mono text-sm tracking-widest text-sky-400">
      03 / PROYECTOS
    </p>

    <h2 class="mt-4 text-3xl font-bold md:text-4xl">
      Algunos proyectos en los que
      <span class="text-sky-400">estoy trabajando.</span>
    </h2>

    <p class="mt-4 max-w-2xl leading-relaxed text-slate-400">
      Proyectos personales y de desarrollo web en los que aplico
      los conocimientos adquiridos durante mi formación.
    </p>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    {projects.map((project) => (
      <article
        class="group flex flex-col rounded-xl border border-slate-700 bg-[#10243D] p-6 transition duration-300 hover:-translate-y-1 hover:border-sky-400/60"
      >
        <div class="flex items-center justify-between">
          <span class="font-mono text-sm text-sky-400">
            PROJECT_{project.number}
          </span>

          <span class="rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs text-amber-300">
            {project.status}
          </span>
        </div>

        <div class="my-8 flex h-40 items-center justify-center rounded-lg border border-slate-700 bg-[#081525]">
          <span class="font-mono text-5xl font-bold text-sky-400/70">
            {project.icon}
          </span>
        </div>

        <p class="font-mono text-xs tracking-wider text-sky-400">
          {project.category}
        </p>

        <h3 class="mt-3 text-2xl font-bold text-white">
          {project.title}
        </h3>

        <p class="mt-4 flex-1 leading-relaxed text-slate-400">
          {project.description}
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {project.technologies.map((technology) => (
            <span class="rounded-md border border-slate-600 bg-[#081525] px-3 py-2 text-xs text-slate-300">
              {technology}
            </span>
          ))}
        </div>

        <div class="mt-6 border-t border-slate-700 pt-4">
          <span class="font-mono text-xs text-slate-500">
            &lt; PROJECT IN PROGRESS /&gt;
          </span>
        </div>
      </article>
    ))}
  </div>
</section>
